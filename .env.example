# --- Phase 1: mock (default) ---
# (no env vars)

# --- Phase 2: Prisma + SQLite + Auth.js (local only) ---
# NEXT_PUBLIC_USE_PRISMA=true
# DATABASE_URL="file:./dev.db"

# Auth.js — required
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → Web client)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Phase 3: Supabase (Vercel deploy) ---
NEXT_PUBLIC_USE_SUPABASE=true
NEXT_PUBLIC_USE_PRISMA=false
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do not enable USE_PRISMA and USE_SUPABASE together.
# Google OAuth (paste into Supabase Dashboard → Auth → Providers → Google)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Optional: SUPABASE_ACCESS_TOKEN then run npm run supabase:enable-google
# Google Cloud redirect URI: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# Supabase URL config: Site URL http://localhost:3000, Redirect http://localhost:3000/auth/callback
